{
  "name": "soulsaka-web",
  "private": true,
  "version": "0.1.0",
  "description": "soulsaka web app: capture, chat, memories, corpus, training and evals against a local hub.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
